  {
    "name": "23_upload_session_small_threshold",
    "description": "Run mode=file: forces client.uploader.SIMPLE_UPLOAD_THRESHOLD/CHUNK_SIZE down to a tiny value (scripts/record_vcr_cassettes.py monkeypatches this scenario only) so the small fixture file goes through createUploadSession + chunked PUT instead of a simple PUT. A resumed chunk is captured only if a transient error happens to occur live (best-effort per design spec \u00a77 \u2014 not forced).",
    "config": {
      "parameters": {
        "mode": "file",
