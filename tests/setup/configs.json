  {
    "name": "20_file_conflict_replace",
    "description": "Run mode=file: simple PUT upload (small file, below the real SIMPLE_UPLOAD_THRESHOLD), conflict_behavior=replace, targeting the SharePoint site's own default drive. Creates the shared target file that 21_file_conflict_fail/22_file_conflict_rename depend on (recorded in this file order) \u2014 also exercises nested folder creation via destination.folder_path.",
    "config": {
      "parameters": {
        "mode": "file",
        "account": {
          "account_type": "sharepoint",
          "tenant_id": "00000000-0000-4000-8000-000000000000",
          "site_url": "https://keboolaconnection.sharepoint.com/sites/allcompany"
        },
        "destination": {
          "folder_path": "keboola-vcr-tests/__RUN_ID__/files",
          "conflict_behavior": "replace"
        }
      },
      "authorization": {
        "oauth_api": {
          "credentials": {
            "appKey": "DUMMY_APP_KEY",
            "#appSecret": "DUMMY_APP_SECRET",
            "#data": "{\"refresh_token\": \"DUMMY_REFRESH_TOKEN\"}"
          }
        }
      },
      "storage": {
        "input": {
          "files": [
            {
              "destination": "vcr_test_file.txt"
            }
          ]
        }
      }
    }
  },
  {
    "name": "21_file_conflict_fail",
